{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": [
    "ast-grep@latest",
    "deno@2",
    "fd@latest",
    "go@1.26",
    "gopls@latest",
    "golangci-lint@latest",
    "gotestsum@latest",
    "jq@latest",
    "just@latest",
    "ripgrep@latest",
    "uv@latest",
    "viu@latest",
    "yq@latest",
    "claude-code@1.0.72"
  ],
  "shell": {
    "init_hook": [
      "go mod tidy",
      "echo '📋 Setting up development environment...'",
      "# Load project-specific Neovim config if it exists",
      "export NVIM_PROJECT_CONFIG=$PWD/.config/nvim",
      "if [ -d \"$NVIM_PROJECT_CONFIG\" ]; then",
      "  export XDG_CONFIG_HOME_NVIM=$PWD/.config",
      "  alias vim='nvim -u $NVIM_PROJECT_CONFIG/init.lua'",
      "  alias nvim='nvim -u $NVIM_PROJECT_CONFIG/init.lua'",
      "  echo '🔧 Project-specific Neovim configuration loaded'",
      "fi"
    ],
    "scripts": {
      "list-issues": ["just list-issues"],
      "formatter": ["just formatter"],
      "builder": ["just builder"],
      "tests": ["just tests"],
      "test-unit": ["just test-unit"],
      "test-integration": ["just test-integration"],
      "linter": ["just linter"],
      "linter-fix": ["just linter-fix"],
      "build-cli": ["just build-cli"],
      "validate-version": ["just validate-version"],
      "ci": ["just ci"],
      "coverage": ["just coverage"],
      "coverage-summary": ["just coverage-summary"],
      "validate-docs": ["just validate-docs"],
      "update-doc-health": ["just update-doc-health"],
      "ccusage": ["just ccusage"],
      "smart-verify": ["just smart-verify"],
      "test-fast": ["just test-fast"],
      "test-smart": ["just test-smart"],
      "test-cached": ["just test-cached"],
      "test-clear-cache": ["just test-clear-cache"]
    }
  }
}
