#!/bin/sh
# Pre-commit hook - runs quality checks before allowing commits
# This ensures code quality standards are maintained across the project
# Optimized to skip tests for markdown-only commits (FEAT-072)

set -e

# Temp files live in the repo-local, gitignored tmp/ (CLAUDE.md: "Create temp
# files in tmp/ directory (not /tmp)"). A per-run mktemp path is required because
# concurrent agent worktrees under .worktrees/ can have commits in flight at the
# same time; a shared absolute path such as /tmp/test_output.log races between them.
mkdir -p tmp
test_log=$(mktemp "tmp/test_output.XXXXXX")
test_failed_marker=$(mktemp "tmp/test_status.XXXXXX")
known_failures_file=$(mktemp "tmp/test_known.XXXXXX")
rm -f "$test_failed_marker"
trap 'rm -f "$test_log" "$test_failed_marker" "$known_failures_file"' EXIT

# Check if devbox is available
if ! command -v devbox >/dev/null 2>&1; then
    echo "❌ Error: devbox is not installed or not in PATH"
    echo "   Install devbox (https://www.jetify.com/devbox) and re-run the commit."
    echo "   The quality checks below cannot run without it."
    exit 1
fi

# Function to detect if only markdown files are staged
is_markdown_only_commit() {
    # Get list of staged files (added, modified, deleted, renamed, copied)
    staged_files=$(git diff --cached --name-only --diff-filter=AMDRC)

    # Return false if no staged files
    if [ -z "$staged_files" ]; then
        return 1
    fi

    # Check each staged file - return false if any non-markdown file found
    for file in $staged_files; do
        case "$file" in
            *.md|*.MD|*.markdown|*.MARKDOWN) continue ;;
            *) return 1 ;;  # Non-markdown file found
        esac
    done

    return 0  # All staged files are markdown
}

# Function to detect whether this commit already touches documentation.
# docs/INDEX.md is an auto-generated dashboard; staging it unconditionally made
# every unrelated commit absorb dashboard churn (timestamp, freshness percentages,
# file counts). The dashboard is derived from docs/*.md, README.md and CLAUDE.md,
# so it is refreshed only when the commit already touches one of those.
commit_touches_docs() {
    git diff --cached --name-only --diff-filter=AMDRC | grep -qE '^(docs/|README\.md$|CLAUDE\.md$)'
}

# Refresh and stage the documentation health dashboard, but only for commits that
# already touch documentation. For any other commit the dashboard is left alone so
# the commit's diff contains exactly what the author changed.
update_doc_health() {
    if ! commit_touches_docs; then
        echo "   Skipping docs/INDEX.md refresh (this commit touches no documentation)"
        return 0
    fi
    if bash scripts/update-doc-health.sh > /dev/null 2>&1; then
        # Stage the updated dashboard alongside the documentation change
        git add docs/INDEX.md 2>/dev/null || true
    fi
}

echo "🔍 Analyzing staged changes..."

# Performance tracking
start_time=$(date +%s)

# Check if this is a markdown-only commit and run appropriate checks
if is_markdown_only_commit; then
    echo "📝 Detected markdown-only changes - optimizing checks..."
    echo "⚡ Skipping tests for documentation-only commit"

    # 1. Run formatter (fast, should complete in ~5s)
    echo "📝 1/2 Running formatter..."
    format_start=$(date +%s)
    if ! devbox run formatter; then
        echo "❌ Formatting check failed!"
        echo "   Run 'devbox run formatter' to fix formatting issues"
        exit 1
    fi
    format_time=$(($(date +%s) - format_start))

    # 2. Run linter (fast, should complete in ~5s)
    echo "🔍 2/3 Running linter..."
    lint_start=$(date +%s)
    if ! devbox run linter; then
        echo "❌ Linting check failed!"
        echo "   The linter (golangci-lint) reported violations in the staged changes."
        echo "   Run 'devbox run linter' to see them, or 'devbox run linter-fix' to"
        echo "   auto-fix what can be fixed, then stage the result and commit again."
        exit 1
    fi
    lint_time=$(($(date +%s) - lint_start))

    # 3. Run documentation validation (fast, should complete in ~1s)
    echo "📚 3/3 Validating documentation..."
    docs_start=$(date +%s)
    if ! bash scripts/validate-docs.sh; then
        echo "❌ Documentation validation failed!"
        echo "   scripts/validate-docs.sh reported problems in the documentation."
        echo "   Run 'devbox run validate-docs' to see the details and fix them,"
        echo "   then stage the result and commit again."
        exit 1
    fi
    docs_time=$(($(date +%s) - docs_start))

    # Update documentation health dashboard (silent, fast)
    update_doc_health

    # Performance summary for markdown-only commits
    total_time=$(($(date +%s) - start_time))
    echo ""
    echo "✅ Markdown-only checks passed!"
    echo "⏱️  Performance: ${total_time}s total (formatter: ${format_time}s, linter: ${lint_time}s, docs: ${docs_time}s)"
    test_time="0 (skipped)"
else
    echo "🔧 Detected code changes - running full quality checks..."

    # 1. Run formatter (fast, should complete in ~5s)
    echo "📝 1/3 Running formatter..."
    format_start=$(date +%s)
    if ! devbox run formatter; then
        echo "❌ Formatting check failed!"
        echo "   Run 'devbox run formatter' to fix formatting issues"
        exit 1
    fi
    format_time=$(($(date +%s) - format_start))

    # 2. Run tests (slower, target ~20s)
    echo "🧪 2/3 Running tests..."
    test_start=$(date +%s)
    # Test output is streamed through tee for live feedback, which makes the
    # pipeline's exit status tee's rather than the test runner's. The runner's
    # status is therefore carried out of the pipeline in a marker file; the '||'
    # keeps 'set -e' from killing the subshell before the marker is written.
    { devbox run tests 2>&1 || printf '%s\n' "$?" > "$test_failed_marker"; } | tee "$test_log"
    if [ -f "$test_failed_marker" ]; then
        # Known-failing tests, pinned BY NAME. Any failure not listed here fails the
        # commit, so a new regression can never be absorbed silently the way the old
        # message-matching carve-out absorbed every tests/security failure.
        #
        # Currently empty: no test is a known, tolerated failure. The two entries
        # that used to live here (pkg/analyzer TestDocSyncCommand_E2E and
        # TestDocSyncCommand_E2E_ConfigManagement, tolerated because their e2e
        # helper built the CLI from a path relative to the package instead of the
        # repository root) were fixed to build against the module root instead.
        #
        # Add an entry here only for a deterministic, understood failure. Do NOT
        # add flaky tests: a load-sensitive failure should fail the gate and
        # simply be re-run.
        : > "$known_failures_file"

        reported_failures=$(grep '^=== FAIL:' "$test_log" || true)
        unexpected_failures=$(printf '%s\n' "$reported_failures" \
            | sed -e 's/^=== FAIL: //' -e 's/ ([0-9][0-9.]*s)$//' -e 's/[[:space:]]*$//' \
            | grep -v '^$' \
            | grep -Fxv -f "$known_failures_file" || true)

        if [ -z "$reported_failures" ]; then
            # The runner exited non-zero without reporting a single test failure,
            # e.g. a compile error or a devbox/gotestsum problem. Never tolerated.
            echo "❌ Tests failed!"
            echo "   'devbox run tests' exited non-zero without reporting any test failure."
            echo "   That usually means a build or tooling error - see the output above."
            exit 1
        fi

        if [ -n "$unexpected_failures" ]; then
            echo "❌ Tests failed!"
            echo "   These failures are not in this hook's known-failing list:"
            printf '%s\n' "$unexpected_failures" | sed 's/^/     /'
            echo "   Fix them, then stage the result and commit again."
            echo "   (The known-failing list lives in .githooks/pre-commit; if one of"
            echo "    these is genuinely pre-existing, pin it there by name.)"
            exit 1
        fi

        echo "⚠️  Tests failed only in the known-failing set pinned in .githooks/pre-commit:"
        printf '%s\n' "$reported_failures" | sed -e 's/^=== FAIL: /     /' -e 's/ ([0-9][0-9.]*s)$//'
        echo "   Continuing with commit..."
    fi
    test_time=$(($(date +%s) - test_start))

    # 3. Run linter (fast, should complete in ~5s)
    echo "🔍 3/4 Running linter..."
    lint_start=$(date +%s)
    if ! devbox run linter; then
        echo "❌ Linting check failed!"
        echo "   The linter (golangci-lint) reported violations in the staged changes."
        echo "   Run 'devbox run linter' to see them, or 'devbox run linter-fix' to"
        echo "   auto-fix what can be fixed, then stage the result and commit again."
        exit 1
    fi
    lint_time=$(($(date +%s) - lint_start))

    # 4. Run documentation validation (fast, should complete in ~1s)
    echo "📚 4/4 Validating documentation..."
    docs_start=$(date +%s)
    if ! bash scripts/validate-docs.sh; then
        echo "❌ Documentation validation failed!"
        echo "   scripts/validate-docs.sh reported problems in the documentation."
        echo "   Run 'devbox run validate-docs' to see the details and fix them,"
        echo "   then stage the result and commit again."
        exit 1
    fi
    docs_time=$(($(date +%s) - docs_start))

    # Update documentation health dashboard (silent, fast)
    update_doc_health

    # Performance summary for full checks
    total_time=$(($(date +%s) - start_time))
    echo ""
    echo "✅ All pre-commit checks passed!"
    echo "⏱️  Performance: ${total_time}s total (formatter: ${format_time}s, tests: ${test_time}s, linter: ${lint_time}s, docs: ${docs_time}s)"

    # Performance warning if hooks are too slow
    if [ $total_time -gt 30 ]; then
        echo "⚠️  Warning: Pre-commit checks took ${total_time}s (target: <30s)"
        echo "   Consider optimizing the test suite; see 'devbox run test-unit' for the"
        echo "   fast subset while iterating locally."
    fi
fi

echo ""
echo "🚀 Ready to commit!"
