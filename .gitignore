#########
# app
#
mobilecombackup
!mobilecombackup/

#########
# GO BUILD ARTIFACTS
#
# Compiled test binaries from `go test -c` (e.g. agents.test). Never tracked.
# Safe as a broad glob: no tracked file in this repo ends in `.test`
# (`git ls-files | grep -E '\.test$'` matched only the build artifact itself).
*.test

#########
# VI
#
*.swp

#########
# DEVENV
#
.devenv/
.direnv/
.pre-commit-config.yaml

#########
# agents
#
.serena/
.beads/

#########
# PYTHON
#
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
# C extensions
*.so
# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
coverage.out
coverage.html
*.cover
*.py,cover
