#!/bin/bash

# Automatically activates the flox environment whenever you cd into this
# directory via our direnv integration (tc-5lxy.9, replacing the previous
# shell-management tool).
#
# `use flox` is direnv's own built-in stdlib function (verified via
# `direnv stdlib` on direnv 2.37.1: it defines `use_flox`, invoking
# `flox activate ... -- "$direnv" dump`). It was originally shipped as an
# external library (github.com/flox/flox-direnv) that direnv has since
# merged upstream, so no separate library install/source_url is needed here.

use flox

# https://flox.dev/docs/tutorials/direnv/ for more details
